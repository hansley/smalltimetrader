# Generate: python -m smalltimetrader.cli key
APP_ENCRYPTION_KEY=
DOMAIN=trader.your-domain.example
DATABASE_PATH=data/trader.sqlite
# Set to false ONLY for localhost development over HTTP.
COOKIE_SECURE=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Live execution requires BOTH this gate and mode=live in the MFA-protected UI.
ENABLE_LIVE_TRADING=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SID=
